# ==============================================================================
# JobReactor - Environment Configuration Template
# Copy this file to '.env' and modify the values for local run.
# ==============================================================================

# Node Environment (development | production | test)
NODE_ENV=development

# Queue Settings
QUEUE_NAME=default
CONCURRENCY=8

# Redis Configuration
# If running via Docker Compose, use 'redis' as the host.
# For local running without Docker, use 'localhost'.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API Server Configuration
PORT=3000

# Dashboard Configuration (Vite defaults to 5173 / 3001 depending on setup)
PORT_DASHBOARD=3001
VITE_API_URL=http://localhost:3000
